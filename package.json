{
  "name": "tata-boutique",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply tata_boutique_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tata_boutique_db --remote",
    "db:seed:local": "wrangler d1 execute tata_boutique_db --local --file=./migrations/0002_seed.sql",
    "db:seed:remote": "wrangler d1 execute tata_boutique_db --remote --file=./migrations/0002_seed.sql",
    "create-admin": "node workers/scripts/create-admin.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^3.90.0"
  }
}
